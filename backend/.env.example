PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/git_indent_management
JWT_SECRET=replace_with_a_long_random_string_32_chars_or_more
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads

# Email (optional - if unset, OTPs/notifications are logged to the console instead of emailed)
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_SERVICE=gmail

# Monthly indent statistics email to the Principal (sent on the 1st for the previous month)
# MONTHLY_REPORT_ENABLED=true          # set to false to turn it off
# MONTHLY_REPORT_SEND_HOUR=8           # IST hour on the 1st after which it is sent
# MONTHLY_REPORT_CC=admin@example.com  # optional, comma-separated
